# Copy to .env and fill in. .env is ignored by git: secrets never go into the repository.

# Long random string (at least 32 characters). PowerShell: [guid]::NewGuid().ToString('N') + [guid]::NewGuid().ToString('N')
KOEDER_JWT_SECRET=
# Password of the demo manager in the admin panel (thomas@muster-automotive.example)
KOEDER_DEMO_PASSWORD=
KOEDER_DB_PASSWORD=koeder

# Your domain for automatic HTTPS, e.g. koeder.example.org. Leave empty for plain http on port 80 (laptop on a hotspot).
KOEDER_DOMAIN=
# Add https://your-domain here when you set a domain
# KOEDER_CORS_ORIGINS=https://koeder.example.org

# Optional: real Claude answers in "Check a message" and the scenario generator.
# Without a key both still work through local rules and templates, and the UI says so.
ANTHROPIC_API_KEY=

# Demo behaviour: seed company, guests join it automatically, /api/me/demo-reset is open.
# Turn this off for anything other than a demo.
KOEDER_DEMO_ENABLED=true
KOEDER_DEMO_AUTO_JOIN=true
KOEDER_BOT_FALLBACK_SECONDS=8
